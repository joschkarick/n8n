# --- Mealie -----------------------------------------------------------------
# Der Token bleibt im Container und erreicht Claude nie.
MEALIE_BASE_URL=https://mealie.joschka.eu
MEALIE_API_KEY=

# --- Oeffentliche Adresse dieses Dienstes ------------------------------------
# Muss exakt der Domain entsprechen, die du in NPMplus anlegst.
PUBLIC_URL=https://mealie-mcp.joschka.eu

# --- Authentik ---------------------------------------------------------------
# Issuer des OAuth2/OpenID-Providers, mit Slash am Ende.
# Steht in Authentik beim Provider unter den OpenID Configuration URLs.
OIDC_ISSUER=https://login.joschka.eu/application/o/mealie-mcp/

# Erwartete aud-Claim. Authentik setzt hier standardmaessig die Client-ID.
# Leer lassen schaltet die Pruefung ab - nur voruebergehend zum Debuggen.
OIDC_AUDIENCE=

# --- Host-Port ---------------------------------------------------------------
# Port auf dem Host, ueber den NPMplus den Dienst erreicht. Im Container
# bleibt es immer 8000. Aendern, falls der Port schon belegt ist:
#   ss -tlnp | grep :18000
HOST_PORT=18000

# --- Sonstiges ---------------------------------------------------------------
# Das MCP-SDK prueft den Host-Header. Der Hostname aus PUBLIC_URL ist
# automatisch erlaubt. Weitere nur noetig, wenn dein Proxy einen anderen
# Host durchreicht - kommagetrennt.
# EXTRA_ALLOWED_HOSTS=mealie-mcp:8000

# Falls der MCP-Server sein FastMCP-Objekt woanders hat, weil das Repo
# umgebaut wurde: Modulpfad hier setzen, statt gateway.py zu aendern.
# Den richtigen Namen zeigt "pip show -f mealie-mcp-server".
# MCP_MODULE=server
# MCP_ATTR=mcp

# MCP_PATH=/mcp
# LOG_LEVEL=DEBUG
